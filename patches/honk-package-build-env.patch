diff --git a/honk/Makefile b/honk/Makefile
index da1e12d..91d06c9 100644
--- a/honk/Makefile
+++ b/honk/Makefile
@@ -12,9 +12,9 @@
 # nightly toolchain pinned in crates/honk-ebpf/rust-toolchain.toml, compiles
 # honk-core with the crate's own pinned stable toolchain, and uses the OpenWrt
 # cross gcc/g++ of the SDK (TARGET_CROSS) for BoringSSL, SQLite and the final
-# link. HONK_VERSION is the package version (0.1.0_beta5, apk spells the beta
+# link. HONK_VERSION is the package version (0.1.0_beta4, apk spells the beta
 # pre-release with "_beta") and HONK_GIT_TAG the upstream tag the sources come
-# from (v0.1.0-beta.5), which is the version honk's build script embeds.
+# from (v0.1.0-beta.4), which is the version honk's build script embeds.
 #
 # The binary is built with the full feature set: the crate defaults
 # (clash-api, mimalloc, rprx) plus ebpf and native-ui. native-ui embeds the
@@ -38,12 +38,12 @@ PKG_DIR:=$(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=honk
-PKG_VERSION:=$(if $(HONK_VERSION),$(HONK_VERSION),0.1.0_beta5)
+PKG_VERSION:=$(if $(HONK_VERSION),$(HONK_VERSION),0.1.0_beta4)
 PKG_RELEASE:=1
 
 # Upstream release the sources are checked out from. honk's build script derives
 # the version it embeds from the tag in GITHUB_REF, so build.sh exports it.
-HONK_GIT_TAG:=$(if $(HONK_GIT_TAG),$(HONK_GIT_TAG),v0.1.0-beta.5)
+HONK_GIT_TAG:=$(if $(HONK_GIT_TAG),$(HONK_GIT_TAG),v0.1.0-beta.4)
 
 PKG_LICENSE:=GPL-3.0-only
 PKG_LICENSE_FILES:=LICENSE
@@ -88,14 +88,30 @@ define Build/Prepare
 	$(CP) $(HONK_SRC)/. $(PKG_BUILD_DIR)/
 endef
 
+# Rust build environment.
+HONK_RUST_HOME?=$(if $(wildcard $(HOME)/.cargo/bin/cargo),$(HOME),/home/runner)
+HONK_RUSTUP_HOME?=$(HONK_RUST_HOME)/.rustup
+HONK_CARGO_HOME?=$(HONK_RUST_HOME)/.cargo
+HONK_CARGO_JOBS?=2
+
+HONK_TARGET_ARCH = $(strip $(if $(ARCH_PACKAGES),$(ARCH_PACKAGES),$(if $(filter x86_64,$(ARCH)),x86_64,$(if $(findstring aarch64,$(ARCH)$(TARGET_CROSS)$(CONFIG_TARGET_ARCH_PACKAGES)),aarch64_cortex-a53,$(ARCH)))))
+HONK_TOOLCHAIN_BIN = $(strip $(if $(wildcard $(TOOLCHAIN_DIR)/bin),$(TOOLCHAIN_DIR)/bin,$(STAGING_DIR)/toolchain-$(GNU_TARGET_NAME)/bin))
+HONK_CC = $(strip $(if $(wildcard $(TOOLCHAIN_DIR)/bin/$(TARGET_CROSS)gcc),$(TOOLCHAIN_DIR)/bin/$(TARGET_CROSS)gcc,$(TARGET_CC)))
+HONK_CXX = $(strip $(if $(wildcard $(TOOLCHAIN_DIR)/bin/$(TARGET_CROSS)g++),$(TOOLCHAIN_DIR)/bin/$(TARGET_CROSS)g++,$(TARGET_CXX)))
+
 define Build/Compile
+	RUSTUP_HOME="$(HONK_RUSTUP_HOME)" \
+	CARGO_HOME="$(HONK_CARGO_HOME)" \
+	PATH="$(HONK_CARGO_HOME)/bin:$(HONK_TOOLCHAIN_BIN):$(STAGING_DIR)/host/bin:$$PATH" \
+	CARGO_PROFILE_RELEASE_LTO=false \
+	CARGO_BUILD_JOBS="$(HONK_CARGO_JOBS)" \
 	HONK_SRC="$(PKG_BUILD_DIR)" \
 	HONK_VERSION="$(PKG_VERSION)" \
 	HONK_GIT_TAG="$(HONK_GIT_TAG)" \
-	HONK_ARCH_PACKAGES="$(ARCH_PACKAGES)" \
-	OPENWRT_CC="$(TARGET_CROSS)gcc" \
-	OPENWRT_CXX="$(TARGET_CROSS)g++" \
-	sh "$(PKG_DIR)/build.sh"
+	HONK_ARCH_PACKAGES="$(HONK_TARGET_ARCH)" \
+	OPENWRT_CC="$(HONK_CC)" \
+	OPENWRT_CXX="$(HONK_CXX)" \
+	bash -c 'set -o pipefail; bash "$$0" 2>&1 | tee /tmp/honk-build.log' "$(PKG_DIR)/build.sh"
 endef
 
 define Package/honk/conffiles
