# ImmortalWrt 25.12.2 (Linux 6.12.103) - mediatek/filogic for the
# GL.iNet GL-MT3000 (DEVICE_glinet_gl-mt3000, sysupgrade.bin).
#
# This is a seed config, not a full .config: `make defconfig` fills in every
# default and keeps what is written here.

# ---------------------------------------------------------------------------
# Target: MediaTek Filogic, GL.iNet GL-MT3000 only
# ---------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt3000=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_glinet_gl-mt3000=""

# ---------------------------------------------------------------------------
# Kernel BTF, required by honk (eBPF CO-RE needs /sys/kernel/btf/vmlinux)
# ---------------------------------------------------------------------------
CONFIG_KERNEL_DEBUG_INFO=y
# ImmortalWrt turns BTF on only for its own buildbot: BTF and full debug info
# default off for everyone else, because KERNEL_DEBUG_INFO_REDUCED defaults to
# y when BUILDBOT is unset and BTF depends on !KERNEL_DEBUG_INFO_REDUCED. These
# lines are what makes /sys/kernel/btf/vmlinux exist in the built image.
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_DWARVES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_NETKIT=y

# ---------------------------------------------------------------------------
# honk + LuCI stack, all built into the rootfs
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y

CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_firewall4=y

# ---------------------------------------------------------------------------
# LuCI theme
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y

# ---------------------------------------------------------------------------
# Device packages of the GL-MT3000 profile. The device profile already carries
# them (target/linux/mediatek/image/filogic.mk); listed so the intent is on
# record and a defconfig run cannot drop one silently.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_automount=y

# The filogic target pulls `bridger` in through DEFAULT_PACKAGES; this build
# removes it from that list at build time (scripts/prepare-tree.sh), so it must
# not be selected here either.
# CONFIG_PACKAGE_bridger is not set
