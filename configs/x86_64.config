# ImmortalWrt 25.12.2 (Linux 6.12.103) - x86/64 "Generic", squashfs rootfs in a
# combined BIOS+EFI disk image.
#
# This is a seed config, not a full .config: `make defconfig` fills in every
# default and keeps what is written here. It carries only the deviations that
# matter for this build, so it stays readable when ImmortalWrt moves.

# ---------------------------------------------------------------------------
# Target: x86/64, generic device
# ---------------------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
CONFIG_TARGET_DEVICE_PACKAGES_x86_64_DEVICE_generic=""

# ---------------------------------------------------------------------------
# Image: squashfs + combined-efi (the .img.gz boots from BIOS and from UEFI)
# ---------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 1 GiB rootfs partition; the default 256 MiB leaves little room once the honk
# binary, the embedded doona UI and the geo databases are in the image.
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y

# The container images are not needed; they only cost build time and disk.
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ---------------------------------------------------------------------------
# Kernel BTF, required by honk (eBPF CO-RE needs /sys/kernel/btf/vmlinux)
# ---------------------------------------------------------------------------
CONFIG_KERNEL_DEBUG_INFO=y
# ImmortalWrt turns BTF on only for its own buildbot: BTF and full debug info
# default off for everyone else, because KERNEL_DEBUG_INFO_REDUCED defaults to
# y when BUILDBOT is unset and BTF depends on !KERNEL_DEBUG_INFO_REDUCED. These
# lines are what makes /sys/kernel/btf/vmlinux exist in the built image.
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_DWARVES=y
# Defaults that follow from BTF, written out so the intent is visible.
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_NETKIT=y

# ---------------------------------------------------------------------------
# honk + LuCI stack, all built into the rootfs
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y

# Stands in for vmlinux-btf on a kernel that carries its own BTF (ImmortalWrt
# kernels do, with the BTF options above). honk depends on vmlinux-btf and this
# package provides it; the detached-blob package would refuse to install here.
CONFIG_PACKAGE_vmlinux-btf-builtin=y

# honk runtime dependencies. honk's Makefile pulls them in by itself; they are
# listed so that a defconfig run cannot drop one silently.
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_firewall4=y

# ---------------------------------------------------------------------------
# LuCI theme
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y

# ---------------------------------------------------------------------------
# Wired NIC drivers (every one of these is a kernel module in this target)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-e100=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-i40e=y

# Virtual NICs: virtio_net and virtio_pci are built into this target's kernel
# (CONFIG_VIRTIO_NET=y and CONFIG_VIRTIO_PCI=y in target/linux/x86/64/config-6.12),
# so ImmortalWrt ships no kmod-virtio-net / kmod-virtio-pci packages. Writing
# those symbols here would have no effect: defconfig would drop them.
